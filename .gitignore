# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.pytest-tmp*/
pytest-cache-files-*/
.ruff_cache/
torchinductor_*/

# 本地验证产物（不随源码提交）
.tools/
.torch-cache/
.validation/
acl-recovery/
# Edge TTS 每次播报生成的 mp3（默认输出目录，见 RN18_TTS_DIR）
.tts/

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store

# 原子写入的残留临时文件
*.tmp

# 本地密钥配置：只提交 .env.example，真实 .env 绝不入库
.env
.env.local

# 数据集：图片与特征库全部留在本地，只提交可复核的清单。
# 用 data/* 而不是 data/：父目录被整体忽略后，!data/manifest.csv 无法再放行。
data/*
!data/manifest.csv

# pytest 自定义 --basetemp 产物
pytest-of-*/
.pytest-tmp*/
