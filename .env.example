# 百度短语音识别（ASR）配置示例
# 复制本文件为 .env 并填入真实值；.env 已在 .gitignore 中，不会被提交。
# 密钥只从环境变量或 .env 读取，绝不写死在代码里。

# 必填：百度智能云"语音技术"应用的 API Key 与 Secret Key
BAIDU_ASR_API_KEY=你的API_KEY
BAIDU_ASR_SECRET_KEY=你的SECRET_KEY

# 选填：识别模型。1537=标准版（默认），80001=极速版。两者端点不同，不能混用。
BAIDU_ASR_DEV_PID=1537

# 选填：额外指定一个 .env 文件路径，优先级高于 ~/.rn18/.env 与仓库根 .env
# RN18_ENV_FILE=/path/to/another/.env
