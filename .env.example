# 百度短语音识别密钥（本地填写，绝不要提交真实值）
# 获取方式：百度智能云控制台 -> 语音技术 -> 应用列表 -> API Key / Secret Key
BAIDU_ASR_API_KEY=
BAIDU_ASR_SECRET_KEY=

# 识别模型：1537 = 普通话（标准版，默认）；80001 = 普通话（极速版）
# 两者端点不同，必须与 Key 对应；实际以 ~/.rn18/.env 里的值为准
BAIDU_ASR_DEV_PID=1537

# 选填：额外指定一个 .env 文件路径，优先级高于 ~/.rn18/.env 与仓库根 .env
# RN18_ENV_FILE=/path/to/another/.env
